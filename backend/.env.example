# Copy this file to .env and fill in real values before running the app.

# Port the Express server listens on
PORT=4000

# Every customer-facing URL lives under this prefix:
#   {BASE_PATH}/admin              -> admin panel
#   {BASE_PATH}/<client-slug>      -> a client's questionnaire
# Must also be set as VITE_BASE_PATH when building the admin panel (see
# admin/.env.example) - they must match.
BASE_PATH=/websitediscovery

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=questionnaire

# Secret used to sign admin-login JWTs. MUST be set to a long random value
# in production (e.g. `openssl rand -hex 32`) - if left unset the app falls
# back to an insecure default and prints a warning on startup.
JWT_SECRET=change-me-to-a-long-random-string
