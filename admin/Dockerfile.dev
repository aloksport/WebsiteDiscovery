# Development image for the admin panel: installs dependencies and runs the
# Vite dev server with hot reload. docker-compose.yml mounts admin/src over
# this at runtime, so code edits on your machine are picked up immediately.
FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
