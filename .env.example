# Used by docker-compose.prod.yml on the webserver.
# Copy this file to .env (same folder) and fill in real values:
#   cp .env.example .env
#
# Do not commit the real .env file anywhere.

DB_NAME=questionnaire
DB_USER=questionnaire_user
DB_PASSWORD=change-me-to-a-strong-password

# Every customer-facing URL lives under this prefix:
#   https://your-domain.com{BASE_PATH}/admin           -> admin panel
#   https://your-domain.com{BASE_PATH}/<client-slug>   -> a client's questionnaire
# Changing this after the first build requires rebuilding the image
# (docker compose -f docker-compose.prod.yml up -d --build), since it's
# baked into the admin panel at build time.
BASE_PATH=/websitediscovery

# Secret used to sign admin-login sessions (JWTs). Generate a real random
# value for production, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
